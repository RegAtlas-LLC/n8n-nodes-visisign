          {
            "node": "Send Welcome Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Signed Agreement": {
      "main": [
        [
          {
            "node": "Archive Signed Agreement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
